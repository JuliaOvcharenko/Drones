generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int                @id @default(autoincrement())
  name           String             @unique
  price          Int
  discount       Int
  description    String?
  countOfProduct Int
  category       Category           @relation(fields: [categoryId], references: [id])
  categoryId     Int
  infoBlocks     ProductInfoBlock[]
  mainImage      ProductMainImage?
  orders         OrderProducts[]
  createdAt      DateTime?          @default(now())
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  image    String
  products Product[]
  order    Order?        @relation(fields: [orderId], references: [id])
  orderId  Int?
}

model ProductInfoBlock {
  id         Int            @id @default(autoincrement())
  blockOrder Int 
  align      String
  title      String
  content    String
  product    Product        @relation(fields: [productId], references: [id])
  productId  Int

  video      String?
  
  images     ProductImage[]
}

model ProductImage {
  id          Int              @id @default(autoincrement())
  image       String
  imageOrder  Int
  infoBlock   ProductInfoBlock @relation(fields: [infoBlockId], references: [id])
  infoBlockId Int
}

model ProductMainImage {
  id        Int     @id @default(autoincrement())
  image     String
  product   Product @relation(fields: [productId], references: [id])
  productId Int     @unique
}

model User {
  id          Int      @id @default(autoincrement())
  username    String
  lastname    String
  patronymic  String
  email       String   @unique
  birthDate   DateTime
  phoneNumber String
  password    String
  address     Address? @relation(fields: [addressId], references: [id])
  addressId   Int?
  orders      Order[]
}

model Address {
  id       Int    @id @default(autoincrement())
  city     String
  street   String
  house    String
  flat     String
  entrance String
  userId   User[]
  order    Order?
}

model Order {
  id              Int             @id @default(autoincrement())
  username        String
  lastname        String
  patronymic      String
  totalDiscount   Int
  payment         String
  trackingNumber  Int
  totalPrice      Int
  countOfProducts Int
  orderDate       DateTime
  user            User            @relation(fields: [userId], references: [id])
  userId          Int
  address         Address         @relation(fields: [addressId], references: [id])
  addressId       Int             @unique
  products        OrderProducts[]
  categories      Category[]
}

model OrderProducts {
  Order            Order   @relation(fields: [OrderId], references: [id])
  OrderId          Int
  Product          Product @relation(fields: [productId], references: [id])
  productId        Int
  count_of_product Int
  price            Int
  discount         Int

  @@id([OrderId, productId])
}


model verificationCode{
  email     String    @id
  code      String
  expiresAt DateTime
}